rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Player profiles stored at players/{uid}
    match /players/{playerId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == playerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.id;
    }

    // Optionally restrict any other collections by default
    match /{document=**} {
      allow read, write: if false; // locked down
    }
  }
}
