rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }

    // players/{uid}
    match /players/{playerId} {
      allow create: if isOwner(request.resource.id)
                    && request.resource.data.keys().hasOnly(['name','avatar','progress','updatedAt'])
                    && request.resource.data.updatedAt == request.time;
      allow read: if isOwner(playerId) || isAdmin();
      allow update: if (isOwner(playerId) || isAdmin())
                    && request.resource.data.keys().hasOnly(['name','avatar','progress','updatedAt'])
                    && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(playerId) || isAdmin();
    }

    // public/{doc} (readable by everyone, writable by admins)
    match /public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // sessions/{sessionId} (host-controlled room docs)
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.host == request.auth.uid
                    && request.resource.data.keys().hasAll(['host'])
                    && request.resource.data.host is string;
      allow update, delete: if isSignedIn() && resource.data.host == request.auth.uid;
    }

    // leaderboards/{board}/{userId}
    match /leaderboards/{board}/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && request.resource.data.score >= resource.data.score) || isAdmin();
      allow delete: if isAdmin();
    }

    // items/{itemId} (static catalog)
    match /items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // adminFlags/{flagId}
    match /adminFlags/{flagId} {
      allow read, write: if isAdmin();
    }

    // duels/{code} — ephemeral WebRTC signaling rooms for 1v1 duels (see
    // src/services/duelSignaling.ts). A room holds only the short-lived SDP
    // offer/answer handshake; ICE candidates live in the hostCandidates /
    // guestCandidates subcollections. Codes are random and rooms are torn down
    // on close, so any signed-in player may create, join (read), answer
    // (update), and clean up (delete) a room. Without these rules the default
    // deny below blocks all signaling and no duel can ever connect.
    match /duels/{code} {
      allow read, create, update, delete: if isSignedIn();
      // hostCandidates / guestCandidates — ICE candidate exchange.
      match /{candidateSet}/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }

    // matches/{code} — host-authoritative 1v1v1 MOBA rooms (see
    // src/services/matchSignaling.ts). The room doc holds mode, shared map seed,
    // host uid, phase and winner. Only the host may mutate the room. Each player
    // owns their own slot under players/{uid} (faction pick + presence); the host
    // may also write slots (e.g. to seat/kick). WebRTC signaling for the
    // host<->guest star lives under connections/{guestUid} and is writable only by
    // that guest or the host.
    match /matches/{code} {
      function matchHost() {
        return get(/databases/$(database)/documents/matches/$(code)).data.host;
      }
      allow read:            if isSignedIn();
      allow create:          if isSignedIn() && request.resource.data.host == request.auth.uid;
      allow update, delete:  if isSignedIn() && resource.data.host == request.auth.uid;

      // Per-player slot: faction choice + presence. Owner writes their own; host may too.
      match /players/{uid} {
        allow read:  if isSignedIn();
        allow write: if isSignedIn() && (uid == request.auth.uid || matchHost() == request.auth.uid);
      }

      // Per-guest WebRTC offer/answer + ICE candidates for the host<->guest link.
      match /connections/{guestUid} {
        allow read, write: if isSignedIn() && (guestUid == request.auth.uid || matchHost() == request.auth.uid);
        match /{candidateSet}/{candidateId} {
          allow read, write: if isSignedIn() && (guestUid == request.auth.uid || matchHost() == request.auth.uid);
        }
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
