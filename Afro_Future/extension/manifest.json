{
  "manifest_version": 3,
  "name": "Afro Future Profile Sync",
  "description": "Sync Afro Future player profile (character, skills, avatar) via chrome.storage.sync across signed-in Chrome devices.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:1002/*",
    "http://127.0.0.1:1002/*",
    "https://afro-future.app/*",
    "https://*.afro-future.app/*",
    "https://*.afro-future/*",
    "https://store.afro-future/*",
    "https://demo.afro-future/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:1002/*",
        "http://127.0.0.1:1002/*",
        "https://afro-future.app/*",
        "https://*.afro-future.app/*",
        "https://*.afro-future/*",
        "https://store.afro-future/*",
        "https://demo.afro-future/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Afro Future Sync"
  }
}
