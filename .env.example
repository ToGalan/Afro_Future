# Google OAuth Client ID (used by both client & server)
VITE_GOOGLE_CLIENT_ID=YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Shopify Storefront API (optional — for in-app Store view)
# Public Storefront token is safe for client use; do NOT put Admin API keys here.
VITE_SHOPIFY_STORE_DOMAIN=yourshop.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_access_token

# Optional: custom ports
# PORT=8080
# VITE_PORT=1002
