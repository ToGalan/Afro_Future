# Frontend Google OAuth Client ID (used by Vite build & Google Identity Services button)
VITE_GOOGLE_CLIENT_ID=YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Server-side Google OAuth Client ID (can reuse same value)
GOOGLE_CLIENT_ID=YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Optional: custom ports
# PORT=8080
# VITE_PORT=1002
