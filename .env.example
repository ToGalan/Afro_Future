# Google OAuth Client ID (used by both client & server)
VITE_GOOGLE_CLIENT_ID=YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Shopify Storefront API (optional — for in-app Store view)
# Public Storefront token is safe for client use; do NOT put Admin API keys here.
VITE_SHOPIFY_STORE_DOMAIN=store.afro-future.app
VITE_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_access_token

# Shopify Admin REST (server-side only)
# These should NOT be exposed to the client. Used by server.js for /admin/products proxy.
SHOPIFY_ADMIN_STORE_DOMAIN=yourshop.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
# Optional: API version (defaults to 2024-10)
# SHOPIFY_API_VERSION=2024-10

# Optional: custom ports
# PORT=8080
# VITE_PORT=1002
