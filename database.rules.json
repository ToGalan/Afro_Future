{
  "rules": {
    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$sessionId": {
          ".write": "auth != null && auth.uid == $uid && (!data.exists() || (newData.child('uid').val() == $uid && newData.child('sessionId').val() == data.child('sessionId').val()))",
          ".validate": "newData.hasChildren(['heroPosition','lastActive','connected','sessionId','uid']) && newData.child('uid').val() == $uid && newData.child('heroPosition').hasChildren(['q','r']) && (newData.child('isAnonymous').isBoolean() || !newData.child('isAnonymous').exists()) && (newData.child('displayName').isString() || !newData.child('displayName').exists()) && (newData.child('email').isString() || !newData.child('email').exists())"
        }
      }
    }
  }
}
